# local run only: .dockerignore keeps this file out of the image, where the values come from the cluster config instead
# read by the Vite config, the local-run scripts and `docker compose`
# any key can be set for a single run instead, which wins: LAYOUT_IMAGE_TAG=sha-9c1e044 npm start

# runtime config of the app, served to the browser as public/env-config.js
API_ROOT_URL=/api/books
AUTH_API_ROOT_URL=http://localhost:5002/api/auth
DISABLE_ACCESS_TOKEN_REFRESH=true
DISABLE_DEBUG_TOKEN=false

UI_PORT=3505
# a layout-ui started from its own repo: http://localhost:4500/layout
LAYOUT_UI_URL=http://localhost:6500
# an api started from its own repo: http://localhost:4505 when it runs in a Dev Container too,
API_URL=http://localhost:6505

# which published images the local services run, and which branch their compose files are taken from
LAYOUT_IMAGE_TAG=latest
# a ref containing `#` has to be quoted: node --env-file reads an unquoted # as the start of a comment
LAYOUT_REF=master
API_IMAGE_TAG=latest
API_REF=master
