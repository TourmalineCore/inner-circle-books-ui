// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-dockerfile
{
	"name": "Existing Dockerfile",
	// image with NOT included Cypress is used becuase cypress/included doesn't support browsers installatin for arm64 yet
	"image": "cypress/browsers:node-24.20.0-chrome-152.0.7977.64-1-ff-154.0.1-edge-151.0.4129.107-1",
	"features": {
		"ghcr.io/devcontainers/features/desktop-lite:1.2.10": {},
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.0": {
			"moby": false
		}
	},
	"forwardPorts": [
		6080,
		5901
	],
	// installing dependencies is a one-off, everything else has to happen on every start
	"postCreateCommand": "npm ci",
	// builds env-config.js and starts the services the app talks to, so a ready environment
	// is waiting when the container opens and `npm start` only has to run the app
	"postStartCommand": "npm run create-config:local && npm run local-services:up",
	"runArgs": [
		"--network=host"
	],
	"containerEnv": {
		// https://stackoverflow.com/questions/76555858/how-to-run-cypress-in-interactive-mode-in-a-devcontainer-on-windows-with-docker
		"CHOKIDAR_USEPOLLING": "true"
	},
	"remoteEnv": {
		// https://stackoverflow.com/q/65343518
		// the original host directory which is needed for volume mount commands from inside the container (Docker in Docker)
		// local-run/api-docker-compose.override.yml needs it to mount the mock server config
		"LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
	}
}